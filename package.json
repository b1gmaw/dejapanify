{
  "name": "dejapanify",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that fixes unintuitive Japanese web form UX, starting with half-width/full-width (\u534a\u89d2/\u5168\u89d2) auto-conversion.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "dev": "node scripts/build.mjs --watch",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "node scripts/build.mjs --zip",
    "package": "node scripts/build.mjs --zip",
    "lint:ext": "web-ext lint --source-dir=dist/firefox",
    "assets": "node scripts/make-store-assets.mjs",
    "site": "node scripts/build-site.mjs",
    "demo": "node scripts/build.mjs && node scripts/serve-demo.mjs",
    "e2e": "node scripts/build.mjs --target=firefox && node scripts/e2e.mjs",
    "e2e:headed": "node scripts/build.mjs --target=firefox && node scripts/e2e.mjs --headed"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "author": "b1gmaw",
  "homepage": "https://b1gmaw.github.io/dejapanify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/b1gmaw/dejapanify.git"
  },
  "bugs": {
    "url": "https://github.com/b1gmaw/dejapanify/issues"
  }
}
